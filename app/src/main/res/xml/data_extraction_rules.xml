<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: keep the Online sign-in session out of cloud backups and device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ludomate_online.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ludomate_online.xml" />
    </device-transfer>
</data-extraction-rules>
